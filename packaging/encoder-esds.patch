+// Resolve's audio writer expects an MPEG-4 ES_Descriptor cookie, matching
+// the cookie its QuickTime reader returns. A bare two-byte ASC is not an
+// esds descriptor and can disappear when the host builds the MP4 sample entry.
+static std::vector<uint8_t> MakeESDS(const uint8_t* asc, size_t size, uint32_t bitrate)
+{
+    if (!asc || size == 0 || size > 64) return {};
+    std::vector<uint8_t> v = {3, static_cast<uint8_t>(23 + size), 0, 1, 0,
+        4, static_cast<uint8_t>(15 + size), 0x40, 0x15, 0, 0, 0};
+    for (int repeat = 0; repeat < 2; ++repeat)
+        for (int shift = 24; shift >= 0; shift -= 8)
+            v.push_back(static_cast<uint8_t>(bitrate >> shift));
+    v.push_back(5); v.push_back(static_cast<uint8_t>(size));
+    v.insert(v.end(), asc, asc + size);
+    v.insert(v.end(), {6, 1, 2});
+    return v;
+}
